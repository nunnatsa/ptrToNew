package a

import (
	"fmt"
)

func f() uint64 {
	return 42
}

func ptring() {
	a := new(true)         // want `use the "new" operator instead of ptr\.To; new\(true\)`
	b := new("a string")   // want `use the "new" operator instead of ptr\.To; new\("a string"\)`
	c := new(int32(10))    // want `use the "new" operator instead of ptr\.To; new\(int32\(10\)\)`
	var d = new(int32(10)) // want `use the "new" operator instead of ptr\.To; new\(int32\(10\)\)`
	var e = new(f())       // want `use the "new" operator instead of ptr\.To; new\(f\(\)\)`

	fmt.Println(a, b, c, d, e)
}
